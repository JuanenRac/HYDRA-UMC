{
 "schema": 1,
 "description": "The screens of the interface that runs on the STM32H757 and of the Flutter DSI app, as data. Both read this file; the firmware gets generated tables from it. Positions are pixels of a 1280x720 landscape frame. Evidence: simulator (validated by tools/ui_spec.py); nothing here has run on a display.",
 "display": {
  "width": 1280,
  "height": 720,
  "orientation": "landscape",
  "min_touch_px": 64,
  "min_font_px": 20,
  "stop_min_px": [
   240,
   88
  ]
 },
 "regions": {
  "status_bar": {
   "x": 0,
   "y": 0,
   "w": 1280,
   "h": 56
  },
  "tab_bar": {
   "x": 0,
   "y": 56,
   "w": 1280,
   "h": 80
  },
  "content": {
   "x": 0,
   "y": 136,
   "w": 1280,
   "h": 476
  },
  "footer": {
   "x": 0,
   "y": 612,
   "w": 1280,
   "h": 108
  }
 },
 "theme": {
  "background": "#10151A",
  "surface": "#1B232B",
  "text": "#F2F5F7",
  "text_muted": "#B7C2CC",
  "ok": "#2E7D32",
  "ok_text": "#FFFFFF",
  "warn": "#FFB300",
  "warn_text": "#101010",
  "danger": "#C62828",
  "danger_text": "#FFFFFF",
  "stop": "#B71C1C",
  "stop_text": "#FFFFFF",
  "disabled": "#3A4550",
  "disabled_text": "#C9D2DA"
 },
 "pending_contracts": {
  "brain_kinematics": "position and motion flags the kinematic brain publishes to its own interface; the structure is not fixed yet",
  "jetson_status": "the status frame the Jetson answers over the SPI link (safety verdict, CPU, temperature); the exchange is not fixed yet",
  "jetson_snapshot": "a low-rate still image (thumbnail) from the Jetson; the screen shows it (decision of the owner) but the exchange over the SPI link is not fixed yet"
 },
 "signals": [
  {
   "id": "ui.mode",
   "type": "enum",
   "source": "derived",
   "contract_ref": "local",
   "max_age_ms": 0,
   "needs_jetson": false,
   "note": "mode of the interface (boot, normal, degraded, alarm, stopped), computed by the view-model"
  },
  {
   "id": "ui.banner",
   "type": "enum",
   "source": "derived",
   "contract_ref": "local",
   "max_age_ms": 0,
   "needs_jetson": false,
   "note": "which banner the footer shows"
  },
  {
   "id": "ui.listen_only",
   "type": "bool",
   "source": "local",
   "contract_ref": "local",
   "max_age_ms": 0,
   "needs_jetson": false,
   "note": "listen-only switch kept on the board"
  },
  {
   "id": "ui.jog_armed",
   "type": "bool",
   "source": "derived",
   "contract_ref": "local",
   "max_age_ms": 0,
   "needs_jetson": false,
   "note": "the jog is armed for a few seconds"
  },
  {
   "id": "ui.jog_arm_left_s",
   "type": "int",
   "source": "derived",
   "contract_ref": "local",
   "max_age_ms": 0,
   "needs_jetson": false,
   "note": "seconds left of the armed jog"
  },
  {
   "id": "ui.alarm_count",
   "type": "int",
   "source": "derived",
   "contract_ref": "local",
   "max_age_ms": 0,
   "needs_jetson": false,
   "note": "number of active alarms"
  },
  {
   "id": "ui.alarm_list",
   "type": "list",
   "source": "derived",
   "contract_ref": "local",
   "max_age_ms": 0,
   "needs_jetson": false,
   "note": "the active alarms, worst first"
  },
  {
   "id": "ui.language",
   "type": "enum",
   "source": "local",
   "contract_ref": "local",
   "max_age_ms": 0,
   "needs_jetson": false,
   "note": "language shown"
  },
  {
   "id": "ui.locked",
   "type": "bool",
   "source": "derived",
   "contract_ref": "local",
   "max_age_ms": 0,
   "needs_jetson": false,
   "note": "the optional operator PIN is on and has not been given (STOP never asks for it)"
  },
  {
   "id": "ui.pin_digits",
   "type": "int",
   "source": "local",
   "contract_ref": "local",
   "max_age_ms": 0,
   "needs_jetson": false,
   "note": "digits typed on the pad of the PIN (shown as dots; the digits never enter the view-model)"
  },
  {
   "id": "estop.latched",
   "type": "bool",
   "source": "stack_bus",
   "contract_ref": "can_message:ESTOP_STATE",
   "max_age_ms": 100,
   "needs_jetson": false,
   "note": "the stop is latched (frame of docs/ESTOP_CAN.md)"
  },
  {
   "id": "stack.can_state",
   "type": "enum",
   "source": "stack_bus",
   "contract_ref": "bus_contract:stack_a",
   "max_age_ms": 2000,
   "needs_jetson": false,
   "note": "ok, errors rising, bus off (FDCAN1 status of the brain)"
  },
  {
   "id": "stack.can_tx_errors",
   "type": "int",
   "source": "stack_bus",
   "contract_ref": "can_message:HEALTH_FRAME",
   "max_age_ms": 2000,
   "needs_jetson": false,
   "note": "transmit error counter"
  },
  {
   "id": "stack.can_rx_errors",
   "type": "int",
   "source": "stack_bus",
   "contract_ref": "can_message:HEALTH_FRAME",
   "max_age_ms": 2000,
   "needs_jetson": false,
   "note": "receive error counter"
  },
  {
   "id": "robot.moving",
   "type": "bool",
   "source": "brain",
   "contract_ref": "pending:brain_kinematics",
   "max_age_ms": 500,
   "needs_jetson": false,
   "note": "the brain says an axis is moving"
  },
  {
   "id": "robot.x_mm",
   "type": "float",
   "source": "brain",
   "contract_ref": "pending:brain_kinematics",
   "max_age_ms": 500,
   "needs_jetson": false,
   "note": "position X of the tool"
  },
  {
   "id": "robot.y_mm",
   "type": "float",
   "source": "brain",
   "contract_ref": "pending:brain_kinematics",
   "max_age_ms": 500,
   "needs_jetson": false,
   "note": "position Y of the tool"
  },
  {
   "id": "robot.z_mm",
   "type": "float",
   "source": "brain",
   "contract_ref": "pending:brain_kinematics",
   "max_age_ms": 500,
   "needs_jetson": false,
   "note": "position Z of the tool"
  },
  {
   "id": "mcu.temperature_c",
   "type": "float",
   "source": "local",
   "contract_ref": "local",
   "max_age_ms": 2000,
   "needs_jetson": false,
   "note": "internal temperature sensor of the H757"
  },
  {
   "id": "mcu.uptime_s",
   "type": "int",
   "source": "local",
   "contract_ref": "local",
   "max_age_ms": 0,
   "needs_jetson": false,
   "note": "seconds since the H757 started"
  },
  {
   "id": "jetson.link",
   "type": "enum",
   "source": "derived",
   "contract_ref": "local",
   "max_age_ms": 0,
   "needs_jetson": false,
   "note": "starting, ok, not answering, link fault"
  },
  {
   "id": "jetson.age_ms",
   "type": "int",
   "source": "derived",
   "contract_ref": "local",
   "max_age_ms": 0,
   "needs_jetson": false,
   "note": "milliseconds since the last valid heartbeat of the Jetson"
  },
  {
   "id": "jetson.spi_errors",
   "type": "int",
   "source": "local",
   "contract_ref": "local",
   "max_age_ms": 0,
   "needs_jetson": false,
   "note": "transactions of the link with a bad check or a timeout"
  },
  {
   "id": "jetson.safety_level",
   "type": "enum",
   "source": "jetson_spi",
   "contract_ref": "pending:jetson_status",
   "max_age_ms": 1500,
   "needs_jetson": true,
   "note": "verdict of the safety-zones service (ready, warning, danger, inhibited, fault, unknown)"
  },
  {
   "id": "jetson.cpu_load_pct",
   "type": "int",
   "source": "jetson_spi",
   "contract_ref": "pending:jetson_status",
   "max_age_ms": 1500,
   "needs_jetson": true,
   "note": "CPU load of the Jetson"
  },
  {
   "id": "jetson.temperature_c",
   "type": "float",
   "source": "jetson_spi",
   "contract_ref": "pending:jetson_status",
   "max_age_ms": 1500,
   "needs_jetson": true,
   "note": "temperature of the Jetson"
  },
  {
   "id": "jetson.camera_snapshot",
   "type": "image",
   "source": "jetson_spi",
   "contract_ref": "pending:jetson_snapshot",
   "max_age_ms": 5000,
   "needs_jetson": true,
   "note": "low-rate still image of a camera, a thumbnail of the picture (the video stays on the Jetson; decision of the owner: shown)"
  }
 ],
 "actions": [
  {
   "id": "stop",
