# =============================================================================
# hydra-hmi.service - starting example systemd unit for the Qt6 kiosk shell
# PROJECT: HYDRA-UMC
# AUTHOR: JuanenRac (Electro Hobby 3D) - electrohobby3d@gmail.com
# LICENSE: GPL-3.0 - see repo root LICENSE
#
# NOT YET FUNCTIONAL - ExecStart references a binary path that doesn't
# exist yet (the install step for src/cm5_host/hmi_qt6/'s build output is not
# written - see that folder's own README.md). Written to show the intended
# shape (the kiosk loads the dashboard from HYDRA-UMC-SERVER on
# localhost:3000, so it starts after that service) rather than as something
# to install and enable today.
# =============================================================================
[Unit]
Description=HYDRA-UMC Kiosk HMI Shell
After=hydra-umc-server.service network.target
Requires=hydra-umc-server.service

[Service]
Type=simple
ExecStart=/opt/hydra-umc/bin/hydra_hmi
Restart=on-failure
RestartSec=2
User=hydra
Environment=QT_QPA_PLATFORM=eglfs

# a real, initial cgroup memory ceiling - conservative defaults, meant to be refined once real telemetry from this service running on the CM5 exists, never removed back to unlimited.
MemoryHigh=512M
MemoryMax=768M

[Install]
WantedBy=graphical.target
