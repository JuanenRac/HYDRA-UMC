# Vendored ST HAL/CMSIS sources + compiled objects (fetched fresh by
# build_firmware.sh from ST's own official repos - see docs/COMPILE_STM32G474.md
# and docs/COMPILE_STM32H745.md). Never commit these; they aren't this
# project's own code.
build/

# HYDRA-UMC shared secret protection
.env
.env.*
!.env.example

# Python bytecode (generated locally; never source)
__pycache__/
*.py[cod]

# Editor settings are per-machine (this one holds an absolute local path)
.vscode/*
!.vscode/tasks.json
!.vscode/extensions.json
