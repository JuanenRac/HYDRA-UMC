{
  "about": "Margins of the size check of the bootloaders (tools/bootloader_size.py). The size of each region comes from the linker script; the margin is the least free space, in bytes, that a bootloader must keep in it.",
  "bootloaders": {
    "rcb": {
      "elf_glob": "firmware/HYDRA_RCB_BOOTLOADER_v*.elf",
      "linker": "src/mcu_stm32g474/boot/STM32G474RETx_BOOTLOADER.ld",
      "flash_region": "FLASH_BOOT",
      "flash_margin_bytes": 2048,
      "ram_margin_bytes": 8192
    },
    "kb_cm7": {
      "elf_glob": "firmware/HYDRA_KB_CM7_BOOTLOADER_v*.elf",
      "linker": "src/mcu_stm32h757/CM7/boot/STM32H757XIHx_CM7_BOOTLOADER.ld",
      "flash_region": "FLASH_BOOT",
      "flash_margin_bytes": 4096,
      "ram_margin_bytes": 8192
    },
    "kb_cm4": {
      "elf_glob": "firmware/HYDRA_KB_CM4_BOOTLOADER_v*.elf",
      "linker": "src/mcu_stm32h757/CM4/boot/STM32H757XIHx_CM4_BOOTLOADER.ld",
      "flash_region": "FLASH_BOOT",
      "flash_margin_bytes": 4096,
      "ram_margin_bytes": 8192
    }
  }
}
